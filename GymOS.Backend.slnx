<Solution>
  <!-- Solution folders are a *view*, not the repository layout: they group projects for whoever
       opens this in Visual Studio and never move a file. Four source folders by role — Host,
       Platform, Shared — plus Tests and the compose orchestration.

       Folder names follow the frozen architecture's own vocabulary rather than generic enterprise
       labels: "Gateways" means the on-prem appliance agent in GymOS-Gateway (ADR-52), not this web
       API, and "Services" would imply the microservice split AD-15/ADR-52 explicitly rejected —
       this backend is one deployable. Feature modules get a sibling "Modules" folder when
       src/Modules/ has its first project. -->
  <Folder Name="/Host/">
    <Project Path="src/Host/GymOS.WebApi/GymOS.WebApi.csproj" />
  </Folder>
  <Folder Name="/Platform/">
    <Project Path="src/Platform/GymOS.Platform.Domain/GymOS.Platform.Domain.csproj" />
    <Project Path="src/Platform/GymOS.Platform.Application/GymOS.Platform.Application.csproj" />
    <Project Path="src/Platform/GymOS.Platform.Infrastructure/GymOS.Platform.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/Shared/">
    <Project Path="src/BuildingBlocks/GymOS.SharedKernel/GymOS.SharedKernel.csproj" />
    <Project Path="src/BuildingBlocks/GymOS.BuildingBlocks.Application/GymOS.BuildingBlocks.Application.csproj" />
    <Project Path="src/BuildingBlocks/GymOS.BuildingBlocks.Infrastructure/GymOS.BuildingBlocks.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/Tests/">
    <Project Path="tests/GymOS.ArchitectureTests/GymOS.ArchitectureTests.csproj" />
    <Project Path="tests/GymOS.BuildingBlocks.UnitTests/GymOS.BuildingBlocks.UnitTests.csproj" />
    <Project Path="tests/GymOS.IntegrationTests/GymOS.IntegrationTests.csproj" />
    <Project Path="tests/GymOS.Platform.Application.UnitTests/GymOS.Platform.Application.UnitTests.csproj" />
    <Project Path="tests/GymOS.Platform.Domain.UnitTests/GymOS.Platform.Domain.UnitTests.csproj" />
    <Project Path="tests/GymOS.Platform.Infrastructure.UnitTests/GymOS.Platform.Infrastructure.UnitTests.csproj" />
    <Project Path="tests/GymOS.SharedKernel.UnitTests/GymOS.SharedKernel.UnitTests.csproj" />
    <Project Path="tests/GymOS.TestingSupport/GymOS.TestingSupport.csproj" />
  </Folder>
  <Folder Name="/docker-compose/">
    <File Path=".dockerignore" />
    <File Path="docker-compose.override.yml" />
    <File Path="docker-compose.prod.yml" />
    <File Path="docker-compose.yml" />
    <File Path="docker/postgres/initdb/00-extensions.sql" />
    <File Path="docs/Infrastructure/DOCKER.md" />
    <File Path="src/Host/GymOS.WebApi/Dockerfile" />
    <Project Path="docker-compose.dcproj" Type="E53339B2-1760-4266-BCC7-CA923CBCF16C">
      <!-- VS-only orchestration, excluded from EVERY build configuration: `dotnet build` and CI
           cannot restore a project type only Visual Studio understands (NU1105). If VS rewrites
           this element on save, open Configuration Manager and untick Build for docker-compose
           in BOTH Debug and Release so VS serializes the exclusion itself. -->
      <Build Solution="*|*" Project="false" />
    </Project>
  </Folder>
</Solution>
