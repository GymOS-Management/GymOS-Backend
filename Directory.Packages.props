<Project>
  <!--
    Central Package Management: every NuGet version is declared here, once.
    Projects reference packages without versions — no drift between projects,
    one place to audit licenses (permissive-only policy, AD-1).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Build-time analyzers (apply to every project)">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />
  </ItemGroup>
  <ItemGroup Label="Production">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.1" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <!-- Token creation for the JWT adapter (AD-4). JwtBearer resolves the same
         Microsoft.IdentityModel family transitively; pinned here so both sides of
         issue/validate move together. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <!-- Transitive pin: Microsoft.AspNetCore.OpenApi 10.0.x resolves Microsoft.OpenApi 2.0.0,
         which carries GHSA-v5pm-xwqc-g5wc (high). Pinned to the patched 2.x line. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Transitive pin: Testcontainers.MsSql 4.13.0 resolves SSH.NET 2025.1.0, which carries
         GHSA-q939-rpr3-3284 (high). 4.13.0 is the latest Testcontainers, so there is no upstream
         version to move to yet — pinned here to the patched line instead. Test-only in practice
         (Testcontainers is a test dependency), but NuGet audit fails the whole restore on it, and
         `TreatWarningsAsErrors` is what turns NU1903 into a build break. Drop this pin once
         Testcontainers ships a release that resolves a patched SSH.NET itself. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- The SQL Server provider (AD-11). Version-locked to the rest of the EF Core family above:
         the provider and the relational core ship as one release train, and a provider a patch
         ahead of Microsoft.EntityFrameworkCore.Relational is the one combination EF does not
         support. Microsoft.Data.SqlClient is referenced directly rather than left transitive
         because adapter code names SqlException and SqlParameter — see the Infrastructure
         csproj. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!-- Replaces Npgsql.OpenTelemetry, which shipped its own ActivitySource inside the driver.
         SqlClient emits its spans through DiagnosticSource instead, so the instrumentation is a
         separate package on its own version line — it does not track the EF Core release train. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.15.0" />
    <!-- Renders the OpenAPI document as an API reference UI (MIT). Host-only, and it
         *reads* the document rather than generating it — Microsoft.AspNetCore.OpenApi
         stays the single source of the contract, so the snapshot gate is unaffected. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>