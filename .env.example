# GymOS — environment template.
#
#   cp .env.example .env      (Windows: Copy-Item .env.example .env)
#
# ── You do not need this file to develop ──────────────────────────────────────────────────────
# `docker compose up -d` works from a clean clone with no .env at all: docker-compose.override.yml
# carries development defaults for everything, and they are deliberately public. Copy this file
# only when you want to change something — a different port, JSON logs, a real secret.
#
# ── .env is gitignored, and must stay that way ────────────────────────────────────────────────
# Compose loads .env automatically, which makes it the natural place for a real credential and
# therefore the natural place to leak one. Never commit it. Nothing in *this* file is sensitive:
# every value below is either a placeholder or a development default.
#
# Variable names mirror the application's own configuration keys (ASP.NET maps
# Security__Jwt__SigningKey to Security:Jwt:SigningKey), so there is one naming scheme, not two.
# Full reference: docs/Infrastructure/DOCKER.md.

# ══════════════════════════════════════════════════════════════════════════════════════════════
# PostgreSQL
# ══════════════════════════════════════════════════════════════════════════════════════════════

POSTGRES_DB=gymos
POSTGRES_USER=gymos

# Development default is `gymos_dev_password`, supplied by the override file. Production REQUIRES
# this — the stack refuses to start without it rather than falling back to something guessable.
POSTGRES_PASSWORD=gymos_dev_password

# Host port for the database. Change it if you already run PostgreSQL locally — a native install
# wins the race for 5432 and the symptom is an authentication failure, not a port conflict. The
# API is unaffected either way: it reaches the database over the compose network.
POSTGRES_PORT=5432

# Production only. The container publishes nothing; these describe an external managed instance
# (Azure Database for PostgreSQL, AD-11) when you stop running PostgreSQL in a container.
#POSTGRES_HOST=gymos-db.postgres.database.azure.com
#POSTGRES_PORT_INTERNAL=5432
#POSTGRES_SSL_MODE=Require

# Development convenience: puts parameter values into Npgsql error messages. Never in production —
# those values are member data.
POSTGRES_INCLUDE_ERROR_DETAIL=false

# Full connection string for an EXTERNAL shared development database (e.g. a free Neon instance
# the whole team points at). When set, the API container uses this instead of the local postgres
# sidecar. Leave empty to keep the default per-developer local database. Never commit a real
# value — .env is gitignored, keep it that way. Example:
#GYMOS_DB_CONNECTION=Host=ep-xxxx.eu-central-1.aws.neon.tech;Database=gymos;Username=gymos_owner;Password=<password>;SSL Mode=Require

# ══════════════════════════════════════════════════════════════════════════════════════════════
# GymOS Web API
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Host port. 5080 matches `dotnet run`, so URLs work whichever way the API is running.
API_PORT=5080

# Production: the image CI built and tested. Local development builds from source instead.
#API_IMAGE=ghcr.io/gymos-management/gymos-api:0.7.0

# Production: which interface to publish on. Loopback by default, because only a reverse proxy on
# the same host should reach the API directly.
#API_BIND=127.0.0.1

# Development | Staging | Production. Development is what makes the stack start with no secrets:
# it loads the deliberately public signing key from appsettings.Development.json.
#ASPNETCORE_ENVIRONMENT=Development

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Secrets — placeholders only
# ══════════════════════════════════════════════════════════════════════════════════════════════

# REQUIRED outside Development, where startup validates it is at least 32 bytes and refuses to
# boot otherwise. Generate a unique one per environment:
#     openssl rand -base64 48
# Leave empty for local development.
GYMOS_JWT_SIGNING_KEY=

GYMOS_JWT_ISSUER=gymos-backend
GYMOS_JWT_AUDIENCE=gymos-clients

# The first administrator, created once and never reset. Development defaults to
# admin@gymos.local / gymos-dev-admin-password so a clean clone has a working sign-in. In any real
# environment set these for the first deployment only, then unset them.
GYMOS_SEED_ADMIN_EMAIL=admin@gymos.local
GYMOS_SEED_ADMIN_PASSWORD=gymos-dev-admin-password

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Behaviour
# ══════════════════════════════════════════════════════════════════════════════════════════════

# true only when a reverse proxy genuinely sits in front. Without it the rate limiter sees one
# bucket for every caller and audit rows all record the proxy's address; with it and no proxy, a
# client can spoof its own address.
GYMOS_FORWARDED_HEADERS_ENABLED=false

# Applies EF migrations at container start. On in development (a clean clone has an empty
# database); off in production, where migrations run as a one-shot step so two replicas cannot
# migrate concurrently. See DOCKER.md, "Production workflow".
GYMOS_MIGRATE_ON_STARTUP=true

# json | text. Empty means environment-derived: text in Development, JSON everywhere else. Set
# json locally to see exactly what a log collector will receive.
GYMOS_LOG_FORMAT=

# Verbose | Debug | Information | Warning | Error | Fatal
GYMOS_LOG_LEVEL=Information

# OTLP collector endpoint (AD-38). Empty disables export; nothing else needs changing to enable
# tracing. With the observability profile running: http://seq:5341/ingest/otlp/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Optional services — inert until their profile is enabled
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
#   docker compose --profile tools up -d           pgAdmin + Mailpit (development only)
#   docker compose --profile redis up -d           Redis
#   docker compose --profile observability up -d   Seq
#   docker compose --profile storage up -d         MinIO

PGADMIN_EMAIL=admin@gymos.local
PGADMIN_PASSWORD=gymos-dev-pgadmin
PGADMIN_PORT=5050

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

REDIS_PORT=6379

# Seq's UI is on 80 inside the container; 8341 on the host keeps it clear of the API and pgAdmin.
# 5341 is the ingestion endpoint, published so a host-run `dotnet run` can log into it too.
SEQ_UI_PORT=8341
SEQ_INGEST_PORT=5341

# Seq refuses to start without an administrator password. Sign in as `admin`.
SEQ_ADMIN_PASSWORD=gymos-dev-seq

# MinIO refuses to start without a root password of at least 8 characters.
MINIO_ROOT_USER=gymos
MINIO_ROOT_PASSWORD=gymos-dev-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Resource limits — production overlay only
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# Sized for a small single-host deployment rather than chosen by measurement. Raise them once you
# have numbers.
#API_MEMORY_LIMIT=1g
#POSTGRES_MEMORY_LIMIT=2g
