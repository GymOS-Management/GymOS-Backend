<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RESPONSIBILITY: Platform use cases — commands, queries, validators, and DTOs for
    gym management, subscriptions, platform users, feature flags, settings. (M1+.)
    DEPENDENCIES: Platform.Domain + BuildingBlocks.Application.
    Never references any Infrastructure project (rule R7).
  -->
  <ItemGroup>
    <ProjectReference Include="..\GymOS.Platform.Domain\GymOS.Platform.Domain.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\GymOS.BuildingBlocks.Application\GymOS.BuildingBlocks.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Abstractions only (dependency policy rule 3): options, DI registration, and
         logging contracts. No provider SDK, no EF Core, ever. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
