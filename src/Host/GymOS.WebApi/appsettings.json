{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Idempotency": {
    "LeaseDuration": "00:01:00",
    "PurgeOnStartup": true
  },
  "Security": {
    "Jwt": {
      "Issuer": "gymos-backend",
      "Audience": "gymos-clients",
      "//SigningKey": "SECRET — never set here. user-secrets locally, environment or Key Vault elsewhere. Startup fails if unset or under 32 bytes.",
      "AccessTokenLifetime": "00:15:00",
      "ClockSkew": "00:00:00"
    },
    "PasswordHashing": {
      "MemorySizeKib": 19456,
      "Iterations": 2,
      "DegreeOfParallelism": 1,
      "SaltSizeBytes": 16,
      "HashSizeBytes": 32
    },
    "LoginPolicy": {
      "MaxFailedAttempts": 5,
      "LockoutDuration": "00:15:00",
      "RefreshTokenLifetime": "7.00:00:00",
      "MinimumPasswordLength": 12
    },
    "RateLimiting": {
      "SignInAttemptsPerWindow": 10,
      "SignInWindow": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
