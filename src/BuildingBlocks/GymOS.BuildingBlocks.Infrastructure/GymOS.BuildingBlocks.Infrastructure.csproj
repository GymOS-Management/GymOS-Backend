<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RESPONSIBILITY: Infrastructure implementations of the building-block seams —
    outbox processor, module loader, job runner, EF conventions (naming, RLS),
    storage drivers, SystemClock. (M0.2+.)
    DEPENDENCIES: GymOS.BuildingBlocks.Application (implements its interfaces).
  -->
  <ItemGroup>
    <ProjectReference Include="..\GymOS.BuildingBlocks.Application\GymOS.BuildingBlocks.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- The job runner (M3.4): BackgroundService/AddHostedService live in Hosting.Abstractions;
         BindConfiguration in Options.ConfigurationExtensions. Both Microsoft.Extensions.*,
         the spec-approved family. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
