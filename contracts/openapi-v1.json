              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "List platform roles",
        "tags": [
          "Roles"
        ]
      }
    },
    "/api/v1/roles/{roleId}": {
      "get": {
        "description": "System roles are seeded and their grants are reconciled to the code on every startup, so they are not editable through the API.",
        "operationId": "GetRole",
        "parameters": [
          {
            "in": "path",
            "name": "roleId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
